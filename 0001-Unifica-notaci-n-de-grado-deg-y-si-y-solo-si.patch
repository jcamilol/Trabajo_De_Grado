 \begin{Prop}
-   Sean $G=(V,E)$ un grafo y $M:=\{x\in V\mid d(v)=\Delta (G)\}$. Entonces $M\in\tau_{\mathcal{A},G}$. 
+   Sean $G=(V,E)$ un grafo y $M:=\{x\in V\mid \operatorname{deg}(v)=\Delta (G)\}$. Entonces $M\in\tau_{\mathcal{A},G}$. 
 \end{Prop}
 \begin{proof}
-   Usamos la \Cref{Prop:Caracterizacion_abiertos}. Sea $x\in M$. Veamos que $U_x\subseteq M$. Sea $y\in U_x$. Por la \Cref{Prop:U_x_2} se tiene que $y\in A_w$ para todo $w\in A_x$. De esta forma, para cualquier $w\in A_x$ se tiene $y\in A_w$ y por tanto $w\in A_y$, es decir, $A_x\subseteq A_y$, con lo cual $\Delta(G)=d(x)=|A_x|\le |A_y|=d(y)\le \Delta(G)$ y por tanto $d(y)=\Delta (G)$. Con esto, $y\in M$ y $U_x\subseteq M$. Obtenemos que $U_x$ es una vecindad de $x$ contenida en $M$. Por tanto $M\in\tau_{\mathcal{A},G}$. 
+   Usamos la \Cref{Prop:Caracterizacion_abiertos}. Sea $x\in M$. Veamos que $U_x\subseteq M$. Sea $y\in U_x$. Por la \Cref{Prop:U_x_2} se tiene que $y\in A_w$ para todo $w\in A_x$. De esta forma, para cualquier $w\in A_x$ se tiene $y\in A_w$ y por tanto $w\in A_y$, es decir, $A_x\subseteq A_y$, con lo cual $\Delta(G)=\operatorname{deg}(x)=|A_x|\le |A_y|=\operatorname{deg}(y)\le \Delta(G)$ y por tanto $\operatorname{deg}(y)=\Delta (G)$. Con esto, $y\in M$ y $U_x\subseteq M$. Obtenemos que $U_x$ es una vecindad de $x$ contenida en $M$. Por tanto $M\in\tau_{\mathcal{A},G}$. 
 \end{proof}
 \begin{Prop}
-   Sean $G=(V,E)$ un grafo y $L:=\{x\in V\mid d(v)=\delta(G)\}$. Entonces $L$ es cerrado en $(V,\tau_{\mathcal{A},G})$. 
+   Sean $G=(V,E)$ un grafo y $L:=\{x\in V\mid \operatorname{deg}(v)=\delta(G)\}$. Entonces $L$ es cerrado en $(V,\tau_{\mathcal{A},G})$. 
 \end{Prop}
 \begin{proof}
-   Por la \Cref{Prop:Alexandroff_clausura} se tiene $\overline{L}=\overline{\bigcup_{x\in L}\{x\}}=\bigcup_{x\in L}\overline{\{x\}}$. Sea $y\in \overline{L}$. Entonces existe $x\in L$ tal que $y\in\overline{\{x\}}$. Por el \Cref{Cor:Clausura_unitario} se tiene $A_y\subseteq A_x$. Con esto, $\delta (G)\le d(y)=|A_y|\le |A_x|=\delta (G)$ y por tanto $d(y)=\delta(G)$, es decir, $y\in L$. Obtenemos que $\overline{L}\subseteq L$. Como además $L\subseteq\overline{L}$, entonces $L=\overline{L}$, y por la \Cref{Prop:Caracterizacion_abierto_cerrado} se sigue que $L$ es cerrado en $(V,\tau_{\mathcal{A},G})$.
+   Por la \Cref{Prop:Alexandroff_clausura} se tiene $\overline{L}=\overline{\bigcup_{x\in L}\{x\}}=\bigcup_{x\in L}\overline{\{x\}}$. Sea $y\in \overline{L}$. Entonces existe $x\in L$ tal que $y\in\overline{\{x\}}$. Por el \Cref{Cor:Clausura_unitario} se tiene $A_y\subseteq A_x$. Con esto, $\delta (G)\le \operatorname{deg}(y)=|A_y|\le |A_x|=\delta (G)$ y por tanto $\operatorname{deg}(y)=\delta(G)$, es decir, $y\in L$. Obtenemos que $\overline{L}\subseteq L$. Como además $L\subseteq\overline{L}$, entonces $L=\overline{L}$, y por la \Cref{Prop:Caracterizacion_abierto_cerrado} se sigue que $L$ es cerrado en $(V,\tau_{\mathcal{A},G})$.
 \end{proof}
 \begin{Lema}\label{Lema:x_x}
    Sean $G$ un grafo y $x\in V(G)$ un vértice de corte de $G$. Entonces existen $y_1,y_2\in A_x$ y $D_1,D_2$ componentes distintas de $G-\{x\}$ tales que $y_1\in V(D_1)$ y $y_2\in V(D_2)$.
